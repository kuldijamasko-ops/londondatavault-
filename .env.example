# PayPal checkout configuration (copy to .env; never commit real credentials).
#
# Credentials come from the team Secrets store and are read from the
# environment at runtime — they are never written into this repo.
#   PAYPAL_CLIENT_ID  — from developer.paypal.com > Apps & Credentials
#   PAYPAL_SECRET     — same place
#
# Which PayPal environment to talk to:
#   PAYPAL_MODE=live     -> https://api-m.paypal.com        (real money)
#   PAYPAL_MODE=sandbox  -> https://api-m.sandbox.paypal.com (test money)
# Unset defaults to sandbox. It must match the environment the credentials
# were issued in, or PayPal answers 401 invalid_client.
PAYPAL_MODE=sandbox

# Optional: pin the public origin used for PayPal's return/cancel URLs.
# Derived from the incoming request (x-forwarded-host) when unset.
# PUBLIC_SITE_URL=https://example.cto.site
